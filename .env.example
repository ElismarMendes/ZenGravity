# Configuração de exemplo do ZenGravity (Fase 1)
# Copie para .env se desejar sobrescrever variáveis padrão. Nunca salve senhas ou chaves reais no Git.

# Endereço local da Central (WebSocket e API local)
ZENGRAVITY_CENTRAL_BIND=127.0.0.1:8790

# Caminho do banco de dados SQLite local (modo WAL)
ZENGRAVITY_DB_PATH=data/zengravity.db

# Modo de operação inicial do Desktop: "embedded_sim" (inicia central + simulador local automaticamente) ou "remote_ws"
ZENGRAVITY_DESKTOP_MODE=embedded_sim

# Semente reproduzível do simulador (garante o mesmo comportamento inicial a cada execução)
ZENGRAVITY_SIM_SEED=20261118

# Nível de log (trace, debug, info, warn, error)
RUST_LOG=info,zengravity=debug
